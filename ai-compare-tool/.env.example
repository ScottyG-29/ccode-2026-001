# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Second AI endpoint (any OpenAI-compatible chat completions API) ---
# Examples: https://api.openai.com/v1, a self-hosted vLLM/Ollama server, etc.
SECOND_API_BASE_URL=https://api.openai.com/v1
SECOND_API_KEY=your-key-here
SECOND_API_MODEL=gpt-4o-mini
# Human-readable label shown in the UI and logs for this second source.
SECOND_API_LABEL=OpenAI GPT-4o-mini

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_PORT=5000
