{
  "Filter": {
    "prefix": "filter",
    "body": [
      "filter ${1:column} ${2|=,!=,>,<,>=,<=,contains,starts_with,ends_with,matches,like,in|} ${3:value}"
    ],
    "description": "Filter rows by condition"
  },
  "Filter with AND": {
    "prefix": "filterand",
    "body": [
      "filter ${1:condition1} and ${2:condition2}"
    ],
    "description": "Filter with multiple AND conditions"
  },
  "Filter with OR": {
    "prefix": "filteror",
    "body": [
      "filter ${1:condition1} or ${2:condition2}"
    ],
    "description": "Filter with OR conditions"
  },
  "Make Column": {
    "prefix": "make_col",
    "body": [
      "make_col ${1:new_column}:${2:expression}"
    ],
    "description": "Create or replace a column"
  },
  "Make Multiple Columns": {
    "prefix": "make_cols",
    "body": [
      "make_col",
      "  ${1:col1}:${2:expr1},",
      "  ${3:col2}:${4:expr2}"
    ],
    "description": "Create multiple columns"
  },
  "Pick Columns": {
    "prefix": "pick_col",
    "body": [
      "pick_col ${1:col1}, ${2:col2}, ${3:col3}"
    ],
    "description": "Select specific columns"
  },
  "Drop Columns": {
    "prefix": "drop_col",
    "body": [
      "drop_col ${1:col1}, ${2:col2}"
    ],
    "description": "Remove columns"
  },
  "Rename Column": {
    "prefix": "rename_col",
    "body": [
      "rename_col ${1:new_name}:${2:old_name}"
    ],
    "description": "Rename a column"
  },
  "Stats By": {
    "prefix": "statsby",
    "body": [
      "statsby ${1:result}:${2|count(1),sum($3),avg($3),min($3),max($3),count_distinct($3)|}, group_by(${4:group_column})"
    ],
    "description": "Aggregate with group by"
  },
  "Stats By Multiple": {
    "prefix": "statsbyml",
    "body": [
      "statsby",
      "  ${1:agg1}:${2:count(1)},",
      "  ${3:agg2}:${4:sum($5)},",
      "  group_by(${6:col1}, ${7:col2})"
    ],
    "description": "Aggregate with multiple aggregations"
  },
  "Timechart": {
    "prefix": "timechart",
    "body": [
      "timechart ${1|1m,5m,15m,1h,1d|}, ${2:result}:${3|count(1),sum($4),avg($4)|}"
    ],
    "description": "Time-bucketed aggregation"
  },
  "Align": {
    "prefix": "align",
    "body": [
      "align ${1|1m,5m,15m,1h,1d|}, ${2:result}:${3|count(1),sum($4),avg($4)|}"
    ],
    "description": "Align time series to uniform intervals"
  },
  "Join": {
    "prefix": "join",
    "body": [
      "join ${1:join_key} = @${2:other_dataset}.${3:key}, @${2:other_dataset}"
    ],
    "description": "Inner join with another dataset"
  },
  "Left Join": {
    "prefix": "leftjoin",
    "body": [
      "leftjoin ${1:join_key} = @${2:other_dataset}.${3:key}, @${2:other_dataset}"
    ],
    "description": "Left outer join"
  },
  "Lookup": {
    "prefix": "lookup",
    "body": [
      "lookup ${1:key_column}, @${2:reference_dataset}"
    ],
    "description": "Enrich with lookup data"
  },
  "Union": {
    "prefix": "union",
    "body": [
      "union @${1:other_dataset}"
    ],
    "description": "Combine datasets vertically"
  },
  "Top K": {
    "prefix": "topk",
    "body": [
      "topk ${1:10}, ${2:column}"
    ],
    "description": "Top K rows by column"
  },
  "Bottom K": {
    "prefix": "bottomk",
    "body": [
      "bottomk ${1:10}, ${2:column}"
    ],
    "description": "Bottom K rows by column"
  },
  "Limit": {
    "prefix": "limit",
    "body": [
      "limit ${1:100}"
    ],
    "description": "Limit output rows"
  },
  "Order By": {
    "prefix": "orderby",
    "body": [
      "order_by ${1:column} ${2|desc,asc|}"
    ],
    "description": "Sort rows"
  },
  "Dedup": {
    "prefix": "dedup",
    "body": [
      "dedup ${1:col1}, ${2:col2}"
    ],
    "description": "Remove duplicates"
  },
  "Distinct": {
    "prefix": "distinct",
    "body": [
      "distinct ${1:col1}, ${2:col2}"
    ],
    "description": "Distinct values"
  },
  "Extract Regex": {
    "prefix": "extract_regex",
    "body": [
      "extract_regex ${1:column}, /(?P<${2:name}>${3:pattern})/"
    ],
    "description": "Extract named groups with regex"
  },
  "Parse JSON": {
    "prefix": "parse_json",
    "body": [
      "parse_json ${1:column}"
    ],
    "description": "Parse a JSON string column"
  },
  "Flatten": {
    "prefix": "flatten",
    "body": [
      "flatten ${1:array_column}"
    ],
    "description": "Expand array into rows"
  },
  "Histogram": {
    "prefix": "histogram",
    "body": [
      "histogram ${1:column}, bins:${2:20}"
    ],
    "description": "Create histogram bins"
  },
  "Pivot": {
    "prefix": "pivot",
    "body": [
      "pivot ${1:pivot_column}, ${2:value}:${3|count(1),sum($4),avg($4)|}"
    ],
    "description": "Pivot rows to columns"
  },
  "Make Resource": {
    "prefix": "makeresource",
    "body": [
      "make_resource options(",
      "  primary_key(${1:key_col}),",
      "  valid_from(${2:timestamp_col})",
      ")"
    ],
    "description": "Convert to resource dataset"
  },
  "Set Label": {
    "prefix": "set_label",
    "body": [
      "set_label ${1:column}"
    ],
    "description": "Set display label column"
  },
  "Set Link": {
    "prefix": "set_link",
    "body": [
      "set_link ${1:column}, @${2:target_dataset}"
    ],
    "description": "Link column to another dataset"
  },
  "SIEM: Error Filter Pipeline": {
    "prefix": "siem-errors",
    "body": [
      "// Filter for errors and warnings",
      "filter severity in (\"ERROR\", \"CRITICAL\", \"FATAL\")",
      "| make_col",
      "    source_ip:get_field(FIELDS, \"source.ip\"),",
      "    user:get_field(FIELDS, \"user.name\"),",
      "    message:get_field(FIELDS, \"message\")",
      "| statsby error_count:count(1), group_by(source_ip, user)",
      "| order_by error_count desc",
      "| topk 50, error_count"
    ],
    "description": "SIEM pipeline to find top error sources"
  },
  "SIEM: Login Analysis": {
    "prefix": "siem-logins",
    "body": [
      "// Analyze login activity",
      "filter event_type = \"authentication\"",
      "| make_col",
      "    success:get_field(FIELDS, \"outcome.result\") = \"success\",",
      "    source_ip:get_field(FIELDS, \"source.ip\"),",
      "    user:get_field(FIELDS, \"user.name\")",
      "| statsby",
      "    total:count(1),",
      "    failures:count(not success),",
      "    group_by(user, source_ip)",
      "| make_col failure_rate:round(100.0 * failures / total, 2)",
      "| filter failure_rate > ${1:50}",
      "| order_by failure_rate desc"
    ],
    "description": "SIEM pipeline for login failure analysis"
  },
  "SIEM: Time Series Alert": {
    "prefix": "siem-timeseries",
    "body": [
      "// Time series analysis for alerting",
      "filter ${1:condition}",
      "| timechart ${2|1m,5m,15m,1h|}, event_count:count(1)",
      "| make_col threshold:${3:100}",
      "| filter event_count > threshold"
    ],
    "description": "Time-series pattern for threshold alerting"
  },
  "SIEM: Network Connections": {
    "prefix": "siem-network",
    "body": [
      "// Analyze network connections",
      "filter event_type = \"network\"",
      "| make_col",
      "    src_ip:get_field(FIELDS, \"source.ip\"),",
      "    dst_ip:get_field(FIELDS, \"destination.ip\"),",
      "    dst_port:to_int(get_field(FIELDS, \"destination.port\")),",
      "    bytes:to_int(get_field(FIELDS, \"network.bytes\"))",
      "| statsby",
      "    connections:count(1),",
      "    total_bytes:sum(bytes),",
      "    group_by(src_ip, dst_ip, dst_port)",
      "| order_by total_bytes desc"
    ],
    "description": "SIEM pipeline for network connection analysis"
  }
}
